{
    "name": "stock-course-backend",
    "version": "1.0.0",
    "description": "Phase-1 Backend for Stock Market Course Subscription Platform",
    "main": "dist/server.js",
    "scripts": {
        "dev": "nodemon --exec ts-node src/server.ts",
        "build": "npx prisma generate && tsc",
        "start": "node dist/server.js",
        "postinstall": "npx prisma generate",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:migrate:deploy": "prisma migrate deploy",
        "prisma:studio": "prisma studio",
        "prisma:seed": "ts-node prisma/seed.ts",
        "test": "jest --runInBand",
        "test:watch": "jest --watch"
    },
    "keywords": [
        "stock-market",
        "subscription",
        "backend",
        "typescript"
    ],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@prisma/client": "^5.8.0",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.5",
        "@types/node": "^20.10.6",
        "cashfree-pg": "^5.1.0",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.22.1",
        "express-rate-limit": "^7.1.5",
        "helmet": "^7.1.0",
        "jsonwebtoken": "^9.0.2",
        "prisma": "^5.8.0",
        "twilio": "^4.20.0",
        "typescript": "^5.3.3"
    },
    "devDependencies": {
        "@types/jest": "^30.0.0",
        "fast-check": "^4.6.0",
        "jest": "^30.3.0",
        "nodemon": "^3.0.2",
        "ts-jest": "^29.4.9",
        "ts-node": "^10.9.2"
    },
    "prisma": {
        "seed": "ts-node prisma/seed.ts"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}
